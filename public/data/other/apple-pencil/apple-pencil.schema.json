{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://passionfruit.local/schemas/apple-pencil.schema.json",
	"title": "Apple Pencil accessory group",
	"type": "object",
	"additionalProperties": false,
	"required": ["group", "source", "accessories"],
	"properties": {
		"group": {
			"const": "apple-pencil"
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["url", "localHtmlPath", "styleUrl"],
			"properties": {
				"url": {
					"type": "string",
					"format": "uri"
				},
				"localHtmlPath": {
					"type": "string",
					"minLength": 1
				},
				"styleUrl": {
					"type": "string",
					"format": "uri"
				}
			}
		},
		"accessories": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/accessory"
			}
		}
	},
	"$defs": {
		"image": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "appleUrl", "localPath", "widthPx", "heightPx"],
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1
				},
				"appleUrl": {
					"type": "string",
					"format": "uri"
				},
				"localPath": {
					"type": "string",
					"minLength": 1
				},
				"widthPx": {
					"type": "integer",
					"minimum": 1
				},
				"heightPx": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"color": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName", "images"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"finish": {
					"$ref": "#/$defs/finish",
					"description": "Finish record for the material swatch dot. Optional until backfill completes."
				},
				"images": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/image"
					}
				}
			}
		},
		"finish": {
			"type": "object",
			"additionalProperties": false,
			"required": ["base", "material"],
			"description": "Data-driven finish record. One generic renderer turns this into a material swatch dot (gradient + grain + shine, optional duo split). Never a per-finish asset or custom node.",
			"properties": {
				"base": {
					"type": "string",
					"pattern": "^#[0-9a-fA-F]{6}$",
					"description": "Anchor hex. Also the flat fallback render."
				},
				"material": {
					"enum": [
						"matte-aluminum",
						"brushed-titanium",
						"polished-titanium",
						"polished-steel",
						"ceramic",
						"glass",
						"fabric",
						"flat"
					],
					"description": "Surface recipe: sheen spread, glare, brushed streaks or weave are derived from this."
				},
				"sheen": {
					"type": "object",
					"additionalProperties": false,
					"description": "Optional specular override. Defaults come from material.",
					"properties": {
						"glareX": { "type": "number", "minimum": 0, "maximum": 100 },
						"glareY": { "type": "number", "minimum": 0, "maximum": 100 },
						"intensity": { "type": "number", "minimum": 0, "maximum": 1 }
					}
				},
				"shine": {
					"type": "number",
					"minimum": 0,
					"maximum": 1,
					"description": "Crisp clearcoat hotspot + rim light. 0 none, 1 full glass-like pop. Defaults per material."
				},
				"grain": {
					"type": "number",
					"minimum": 0,
					"maximum": 1,
					"description": "Micro-noise overlay (parametric turbulence, no assets). Matte metals/ceramic low, fabric high."
				},
				"weave": {
					"type": "boolean",
					"description": "Parametric crosshatch overlay for woven fabric (e.g. HomePod mesh). Only meaningful with fabric material."
				},
				"duo": {
					"type": "object",
					"additionalProperties": false,
					"required": ["base", "material"],
					"description": "Second fill for two-tone split dots (e.g. Watch case + band). Grain/shine/sheen apply whole-dot.",
					"properties": {
						"base": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
						"material": {
							"enum": [
								"matte-aluminum",
								"brushed-titanium",
								"polished-titanium",
								"polished-steel",
								"ceramic",
								"glass",
								"fabric",
								"flat"
							]
						},
						"split": {
							"type": "object",
							"additionalProperties": false,
							"description": "Divider geometry. Curve bows the line so it reads as Apple's photographic swoosh, not a straight diagonal.",
							"properties": {
								"angle": {
									"type": "number",
									"minimum": 0,
									"maximum": 360,
									"default": 135
								},
								"curve": {
									"type": "number",
									"minimum": -0.3,
									"maximum": 0.3,
									"default": 0.18
								},
								"offset": {
									"type": "number",
									"minimum": -0.5,
									"maximum": 0.5,
									"default": 0
								}
							}
						}
					}
				}
			}
		},
		"accessory": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"displayName",
				"category",
				"priceAud",
				"colors",
				"images",
				"compatibleDeviceIds",
				"capabilities",
				"sourceUrl",
				"sourceNotes"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"category": {
					"const": "pencil"
				},
				"priceAud": {
					"type": ["number", "null"],
					"minimum": 0,
					"description": "Apple no longer lists a current price for discontinued Apple Pencil models in the supplied evidence; use explicit null only when no published price exists."
				},
				"colors": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/color"
					}
				},
				"images": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/image"
					}
				},
				"compatibleDeviceIds": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
					}
				},
				"capabilities": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"sourceUrl": {
					"type": "string",
					"format": "uri"
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
