{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://passionfruit.local/schemas/apple-pencil.schema.json",
	"title": "Apple Pencil accessory group",
	"type": "object",
	"additionalProperties": false,
	"required": ["group", "source", "accessories"],
	"properties": {
		"group": {
			"const": "apple-pencil"
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["url", "localHtmlPath", "styleUrl"],
			"properties": {
				"url": {
					"type": "string",
					"format": "uri"
				},
				"localHtmlPath": {
					"type": "string",
					"minLength": 1
				},
				"styleUrl": {
					"type": "string",
					"format": "uri"
				}
			}
		},
		"accessories": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/accessory"
			}
		}
	},
	"$defs": {
		"image": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "appleUrl", "localPath", "widthPx", "heightPx"],
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1
				},
				"appleUrl": {
					"type": "string",
					"format": "uri"
				},
				"localPath": {
					"type": "string",
					"minLength": 1
				},
				"widthPx": {
					"type": "integer",
					"minimum": 1
				},
				"heightPx": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"color": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName", "swatch", "images"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"swatch": {
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "value"],
					"properties": {
						"kind": {
							"const": "css"
						},
						"value": {
							"type": "string",
							"pattern": "^#[0-9a-fA-F]{6}$"
						}
					}
				},
				"images": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/image"
					}
				}
			}
		},
		"accessory": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"displayName",
				"category",
				"priceAud",
				"colors",
				"images",
				"compatibleDeviceIds",
				"capabilities",
				"sourceUrl",
				"sourceNotes"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"category": {
					"const": "pencil"
				},
				"priceAud": {
					"type": ["number", "null"],
					"minimum": 0,
					"description": "Apple no longer lists a current price for discontinued Apple Pencil models in the supplied evidence; use explicit null only when no published price exists."
				},
				"colors": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/color"
					}
				},
				"images": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/image"
					}
				},
				"compatibleDeviceIds": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
					}
				},
				"capabilities": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"sourceUrl": {
					"type": "string",
					"format": "uri"
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
