{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://passionfruit.local/schemas/airtag.schema.json",
	"title": "AirTag product group",
	"type": "object",
	"additionalProperties": false,
	"required": ["group", "sources", "products"],
	"properties": {
		"group": { "const": "airtag" },
		"sources": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/source" }
		},
		"products": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/product" }
		}
	},
	"$defs": {
		"identifier": {
			"type": "string",
			"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "url"],
			"properties": {
				"kind": { "enum": ["product", "store", "announcement"] },
				"url": { "type": "string", "format": "uri" }
			}
		},
		"image": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "label", "appleUrl", "localPath", "widthPx", "heightPx", "format", "hasAlpha"],
			"properties": {
				"id": { "$ref": "#/$defs/identifier" },
				"label": { "type": "string", "minLength": 1 },
				"appleUrl": { "type": "string", "format": "uri" },
				"localPath": { "type": "string", "pattern": "^/data/other/airtag/images/" },
				"widthPx": { "type": "integer", "minimum": 1 },
				"heightPx": { "type": "integer", "minimum": 1 },
				"format": { "const": "png" },
				"hasAlpha": { "const": true }
			}
		},
		"configuration": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "quantity", "partNumber", "priceAud", "freeEngraving", "purchaseUrl"],
			"properties": {
				"id": { "$ref": "#/$defs/identifier" },
				"quantity": { "enum": [1, 4] },
				"partNumber": { "type": "string", "pattern": "^[A-Z0-9]+X/A$" },
				"priceAud": { "type": "number", "minimum": 0 },
				"freeEngraving": { "type": "boolean" },
				"purchaseUrl": { "type": "string", "format": "uri" }
			}
		},
		"physical": {
			"type": "object",
			"additionalProperties": false,
			"required": ["diameterMm", "heightMm", "weightGrams"],
			"properties": {
				"diameterMm": { "type": "number", "exclusiveMinimum": 0 },
				"heightMm": { "type": "number", "exclusiveMinimum": 0 },
				"weightGrams": { "type": "number", "exclusiveMinimum": 0 }
			}
		},
		"resistance": {
			"type": "object",
			"additionalProperties": false,
			"required": ["rating", "standard", "maximumDepthMetres", "maximumDurationMinutes"],
			"properties": {
				"rating": { "const": "IP67" },
				"standard": { "const": "IEC 60529" },
				"maximumDepthMetres": { "type": "number", "exclusiveMinimum": 0 },
				"maximumDurationMinutes": { "type": "integer", "minimum": 1 }
			}
		},
		"connectivity": {
			"type": "object",
			"additionalProperties": false,
			"required": ["bluetooth", "ultraWideband", "nfc"],
			"properties": {
				"bluetooth": {
					"type": "object",
					"additionalProperties": false,
					"required": ["proximityFinding", "expandedRange"],
					"properties": {
						"proximityFinding": { "type": "boolean" },
						"expandedRange": { "type": "boolean" }
					}
				},
				"ultraWideband": {
					"type": "object",
					"additionalProperties": false,
					"required": ["chipGeneration", "precisionFinding", "rangeImprovementPercent"],
					"properties": {
						"chipGeneration": { "type": "integer", "minimum": 1 },
						"precisionFinding": { "type": "boolean" },
						"rangeImprovementPercent": { "type": "number", "minimum": 0 }
					}
				},
				"nfc": {
					"type": "object",
					"additionalProperties": false,
					"required": ["lostModeTap"],
					"properties": {
						"lostModeTap": { "type": "boolean" }
					}
				}
			}
		},
		"speaker": {
			"type": "object",
			"additionalProperties": false,
			"required": ["builtIn", "louderThanPreviousGeneration"],
			"properties": {
				"builtIn": { "type": "boolean" },
				"louderThanPreviousGeneration": { "type": "boolean" }
			}
		},
		"battery": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "userReplaceable", "included"],
			"properties": {
				"type": { "const": "CR2032 coin cell" },
				"userReplaceable": { "type": "boolean" },
				"included": { "type": "boolean" }
			}
		},
		"sensors": {
			"type": "object",
			"additionalProperties": false,
			"required": ["accelerometer"],
			"properties": {
				"accelerometer": { "type": "boolean" }
			}
		},
		"platformRequirement": {
			"type": "object",
			"additionalProperties": false,
			"required": ["minimumOperatingSystem"],
			"properties": {
				"minimumOperatingSystem": { "type": "string", "minLength": 1 }
			}
		},
		"watchPrecisionFinding": {
			"type": "object",
			"additionalProperties": false,
			"required": ["minimumOperatingSystem", "compatibleDeviceIds"],
			"properties": {
				"minimumOperatingSystem": { "type": "string", "minLength": 1 },
				"compatibleDeviceIds": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/identifier" }
				}
			}
		},
		"compatibility": {
			"type": "object",
			"additionalProperties": false,
			"required": ["requiresAppleAccount", "requiresFindMy", "iphone", "ipad", "watchPrecisionFinding"],
			"properties": {
				"requiresAppleAccount": { "type": "boolean" },
				"requiresFindMy": { "type": "boolean" },
				"iphone": { "$ref": "#/$defs/platformRequirement" },
				"ipad": { "$ref": "#/$defs/platformRequirement" },
				"watchPrecisionFinding": { "$ref": "#/$defs/watchPrecisionFinding" }
			}
		},
		"environmentalRequirements": {
			"type": "object",
			"additionalProperties": false,
			"required": ["minimumOperatingTemperatureCelsius", "maximumOperatingTemperatureCelsius"],
			"properties": {
				"minimumOperatingTemperatureCelsius": { "type": "number" },
				"maximumOperatingTemperatureCelsius": { "type": "number" }
			}
		},
		"boxItem": {
			"type": "object",
			"additionalProperties": false,
			"required": ["item", "quantityPerAirTag"],
			"properties": {
				"item": { "type": "string", "minLength": 1 },
				"quantityPerAirTag": { "type": "integer", "minimum": 1 }
			}
		},
		"product": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName", "generation", "introducedYear", "current", "technicalSpecificationsUrl", "images", "configurations", "physical", "resistance", "connectivity", "speaker", "battery", "sensors", "compatibility", "environmentalRequirements", "inTheBox"],
			"properties": {
				"id": { "$ref": "#/$defs/identifier" },
				"displayName": { "type": "string", "minLength": 1 },
				"generation": { "type": "integer", "minimum": 1 },
				"introducedYear": { "type": "integer", "minimum": 2000 },
				"current": { "type": "boolean" },
				"technicalSpecificationsUrl": { "type": "string", "format": "uri" },
				"images": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/image" } },
				"configurations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/configuration" } },
				"physical": { "$ref": "#/$defs/physical" },
				"resistance": { "$ref": "#/$defs/resistance" },
				"connectivity": { "$ref": "#/$defs/connectivity" },
				"speaker": { "$ref": "#/$defs/speaker" },
				"battery": { "$ref": "#/$defs/battery" },
				"sensors": { "$ref": "#/$defs/sensors" },
				"compatibility": { "$ref": "#/$defs/compatibility" },
				"environmentalRequirements": { "$ref": "#/$defs/environmentalRequirements" },
				"inTheBox": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/boxItem" } }
			}
		}
	}
}
