{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://passionfruit.local/schemas/vision.schema.json",
	"title": "Apple Vision Pro data",
	"type": "object",
	"additionalProperties": false,
	"required": ["devices"],
	"properties": {
		"devices": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/visionPro" }
		}
	},
	"$defs": {
		"image": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "appleUrl", "localPath", "widthPx", "heightPx"],
			"properties": {
				"label": { "type": "string", "minLength": 1 },
				"appleUrl": { "type": "string", "format": "uri" },
				"localPath": { "type": "string", "minLength": 1 },
				"widthPx": { "type": "integer", "minimum": 1 },
				"heightPx": { "type": "integer", "minimum": 1 }
			}
		},
		"swatch": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "value"],
					"properties": {
						"kind": { "const": "css" },
						"value": { "type": "string", "minLength": 1 }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "url"],
					"properties": {
						"kind": { "const": "image" },
						"url": { "type": "string", "format": "uri" }
					}
				}
			]
		},
		"color": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName", "swatch", "images"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"displayName": { "type": "string", "minLength": 1 },
				"swatch": { "$ref": "#/$defs/swatch" },
				"images": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/image" } },
				"colorPriceAud": { "type": "number", "exclusiveMinimum": 0 },
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"measurement": {
			"type": "object",
			"additionalProperties": false,
			"required": ["value", "unit"],
			"properties": {
				"value": { "type": "number", "minimum": 0 },
				"unit": { "type": "string", "minLength": 1 },
				"qualifier": { "type": "string", "minLength": 1 }
			}
		},
		"storage": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "capacityValue", "capacityUnit"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"displayName": { "type": "string", "minLength": 1 },
				"capacityValue": { "type": "integer", "minimum": 1 },
				"capacityUnit": { "type": "string", "enum": ["GB", "TB"] },
				"priceDeltaAud": { "type": "number", "minimum": 0 },
				"availableColorIds": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 }
				},
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"memory": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "capacityValue", "capacityUnit", "kind"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"displayName": { "type": "string", "minLength": 1 },
				"capacityValue": { "type": "integer", "minimum": 1 },
				"capacityUnit": { "type": "string", "enum": ["GB", "TB"] },
				"kind": { "type": "string", "minLength": 1 },
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"configuration": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "storageId"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"storageId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"priceAud": { "type": "number", "minimum": 0 },
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"cpuCores": {
			"type": "object",
			"additionalProperties": false,
			"required": ["total"],
			"properties": {
				"total": { "type": "integer", "minimum": 1 },
				"performance": { "type": "integer", "minimum": 0 },
				"efficiency": { "type": "integer", "minimum": 0 }
			}
		},
		"chip": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"displayName": { "type": "string", "minLength": 1 },
				"family": { "type": "string", "minLength": 1 },
				"cpuCores": { "$ref": "#/$defs/cpuCores" },
				"gpuCores": { "type": "integer", "minimum": 1 },
				"neuralEngineCores": { "type": "integer", "minimum": 1 },
				"memoryBandwidthGbps": { "type": "number", "minimum": 0 },
				"cpuCoreConfiguration": { "type": "string", "minLength": 1 },
				"neuralAccelerators": { "type": "boolean" },
				"hardwareRayTracing": { "type": "boolean" },
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"display": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"technology",
				"panelKind",
				"resolutionWidthPx",
				"mirroring"
			],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"technology": { "type": "string", "minLength": 1 },
				"panelKind": { "type": "string", "minLength": 1 },
				"sizeIn": { "type": "number", "minimum": 0 },
				"resolutionWidthPx": {
					"type": ["integer", "null"],
					"minimum": 1,
					"description": "Apple does not publish per-eye resolution for Vision Pro (only total pixel count); use explicit null only when the source omits per-eye dimensions."
				},
				"resolutionHeightPx": { "type": "integer", "minimum": 1 },
				"pixelsPerInch": { "type": "number", "minimum": 1 },
				"refreshRateRange": {
					"type": "object",
					"additionalProperties": false,
					"required": ["minimum", "maximum", "unit"],
					"properties": {
						"minimum": { "type": "number", "minimum": 1 },
						"maximum": { "type": "number", "minimum": 1 },
						"unit": { "const": "hz" }
					}
				},
				"wideColorP3": { "type": "boolean" },
				"mirroring": { "type": "boolean" },
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"camera": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "role", "displayName", "megapixels"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"role": { "type": "string", "minLength": 1 },
				"displayName": { "type": "string", "minLength": 1 },
				"megapixels": { "type": "number", "minimum": 0 },
				"apertureFNumber": { "type": "number", "minimum": 0 },
				"spatialCapture": { "type": "boolean" },
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"sensor": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"name": { "type": "string", "minLength": 1 },
				"purpose": { "type": "string", "minLength": 1 },
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"opticId": {
			"type": "object",
			"additionalProperties": false,
			"required": ["available"],
			"properties": {
				"available": { "type": "boolean" },
				"description": { "type": "string", "minLength": 1 },
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"audio": {
			"type": "object",
			"additionalProperties": false,
			"required": ["speaker", "microphone", "spatialAudio", "formats"],
			"properties": {
				"speaker": { "type": "boolean" },
				"microphone": { "type": "boolean" },
				"microphoneConfiguration": { "type": "string", "minLength": 1 },
				"spatialAudio": { "type": "boolean" },
				"formats": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"runtime": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "activity", "hours"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"activity": { "type": "string", "minLength": 1 },
				"hours": { "type": "number", "minimum": 0 }
			}
		},
		"charging": {
			"type": "object",
			"additionalProperties": false,
			"required": ["wirelessCharging"],
			"properties": {
				"portId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"wiredFastCharge": { "type": "boolean" },
				"wirelessCharging": { "type": "boolean" },
				"wirelessStandards": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 }
				},
				"fastChargeMinutesToPercent": { "type": "number", "minimum": 0 },
				"adapterPowerW": { "type": "number", "minimum": 0 }
			}
		},
		"battery": {
			"type": "object",
			"additionalProperties": false,
			"required": ["runtimeHours", "charging"],
			"properties": {
				"capacityMah": { "type": "number", "minimum": 0 },
				"capacityWhr": { "type": "number", "minimum": 0 },
				"runtimeHours": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/runtime" }
				},
				"charging": { "$ref": "#/$defs/charging" }
			}
		},
		"power": {
			"type": "object",
			"additionalProperties": false,
			"required": ["hasExternalPowerAdapter"],
			"properties": {
				"hasExternalPowerAdapter": { "type": "boolean" },
				"outputVoltageV": { "type": "number", "minimum": 0 },
				"outputCurrentA": { "type": "number", "minimum": 0 },
				"outputPowerW": { "type": "number", "minimum": 0 },
				"inputVoltageRangeV": {
					"type": "object",
					"additionalProperties": false,
					"required": ["minimum", "maximum"],
					"properties": {
						"minimum": { "type": "number", "minimum": 0 },
						"maximum": { "type": "number", "minimum": 0 }
					}
				},
				"frequencyHz": { "type": "number", "minimum": 0 },
				"consumptionW": { "type": "number", "minimum": 0 }
			}
		},
		"batteryAndPower": {
			"type": "object",
			"additionalProperties": false,
			"required": ["battery", "power"],
			"properties": {
				"battery": { "$ref": "#/$defs/battery" },
				"power": { "$ref": "#/$defs/power" }
			}
		},
		"port": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "kind"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"kind": { "type": "string", "minLength": 1 },
				"quantity": { "type": "integer", "minimum": 1 },
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"connectivity": {
			"type": "object",
			"additionalProperties": false,
			"required": ["ports", "wifi", "bluetooth"],
			"properties": {
				"ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/port" } },
				"wifi": {
					"type": "object",
					"additionalProperties": false,
					"required": ["standards"],
					"properties": {
						"standards": {
							"type": "array",
							"minItems": 1,
							"items": { "type": "string", "minLength": 1 }
						}
					}
				},
				"bluetooth": {
					"type": "object",
					"additionalProperties": false,
					"required": ["version"],
					"properties": { "version": { "type": "string", "minLength": 1 } }
				}
			}
		},
		"authentication": {
			"type": "object",
			"additionalProperties": false,
			"required": ["methods", "primaryMethod"],
			"properties": {
				"methods": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"primaryMethod": { "type": "string", "minLength": 1 },
				"opticId": { "$ref": "#/$defs/opticId" },
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"physicalComponent": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName", "dimensions", "weight", "weightUnit"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"displayName": { "type": "string", "minLength": 1 },
				"dimensions": {
					"type": "array",
					"items": { "$ref": "#/$defs/measurement" }
				},
				"weight": { "type": "number", "minimum": 0 },
				"weightUnit": { "type": "string", "minLength": 1 },
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"physical": {
			"type": "object",
			"additionalProperties": false,
			"required": ["weights", "dimensions", "components"],
			"properties": {
				"weights": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/measurement" }
				},
				"dimensions": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/measurement" }
				},
				"components": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/physicalComponent" }
				}
			}
		},
		"software": {
			"type": "object",
			"additionalProperties": false,
			"required": ["operatingSystem", "builtInApps"],
			"properties": {
				"operatingSystem": { "type": "string", "minLength": 1 },
				"builtInApps": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		},
		"accessory": {
			"type": "object",
			"additionalProperties": false,
			"required": ["displayName", "category"],
			"properties": {
				"accessoryId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"displayName": { "type": "string", "minLength": 1 },
				"category": { "type": "string", "minLength": 1 },
				"capabilities": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 }
				}
			}
		},
		"visionPro": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"releaseYear",
				"priceAud",
				"colors",
				"configurations",
				"storageOptions",
				"memoryOptions",
				"chips",
				"displays",
				"cameras",
				"audio",
				"batteryAndPower",
				"connectivity",
				"authentication",
				"physical",
				"software",
				"accessories"
			],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
				"name": { "type": "string", "minLength": 1 },
				"releaseYear": { "type": "integer", "minimum": 1976, "maximum": 2100 },
				"priceAud": { "type": ["number", "null"], "minimum": 0, "description": "Use explicit null only when the schema requires the key and the supplied evidence states no price (per data/rules/vision.md)." },
				"colors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/color" } },
				"configurations": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/configuration" }
				},
				"storageOptions": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/storage" }
				},
				"memoryOptions": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/memory" }
				},
				"chips": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/chip" } },
				"displays": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/display" } },
				"cameras": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/camera" } },
				"sensors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sensor" } },
				"audio": { "$ref": "#/$defs/audio" },
				"batteryAndPower": { "$ref": "#/$defs/batteryAndPower" },
				"connectivity": { "$ref": "#/$defs/connectivity" },
				"authentication": { "$ref": "#/$defs/authentication" },
				"physical": { "$ref": "#/$defs/physical" },
				"software": { "$ref": "#/$defs/software" },
				"inputMethods": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"accessories": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/accessory" }
				},
				"sourceNotes": { "type": "string", "minLength": 1 }
			}
		}
	}
}
