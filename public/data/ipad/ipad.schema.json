{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://passionfruit.local/schemas/ipad.schema.json",
	"title": "Canonical iPad data",
	"type": "object",
	"additionalProperties": false,
	"required": ["devices"],
	"properties": {
		"devices": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/ipadDevice"
			}
		}
	},
	"$defs": {
		"ipadDevice": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"releaseYear",
				"priceAud",
				"colors",
				"configurations",
				"storageOptions",
				"chips",
				"displays",
				"cameras",
				"audio",
				"batteryAndPower",
				"connectivity",
				"authentication",
				"physical",
				"resistance",
				"software",
				"accessories",
				"sourceNotes",
				"memoryOptions"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"releaseYear": {
					"type": "integer",
					"minimum": 1976,
					"maximum": 2100
				},
				"priceAud": {
					"type": "number",
					"minimum": 0
				},
				"colors": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadColor"
					}
				},
				"configurations": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadConfiguration"
					}
				},
				"storageOptions": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/ipadStorageOption"
					}
				},
				"chips": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/ipadChip"
					}
				},
				"displays": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/ipadDisplay"
					}
				},
				"cameras": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/ipadCamera"
					}
				},
				"audio": {
					"$ref": "#/$defs/ipadAudio"
				},
				"batteryAndPower": {
					"$ref": "#/$defs/ipadBatteryAndPower"
				},
				"connectivity": {
					"$ref": "#/$defs/ipadConnectivity"
				},
				"authentication": {
					"$ref": "#/$defs/ipadAuthentication"
				},
				"physical": {
					"$ref": "#/$defs/ipadPhysical"
				},
				"resistance": {
					"$ref": "#/$defs/ipadResistance"
				},
				"software": {
					"$ref": "#/$defs/ipadSoftware"
				},
				"accessories": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadAccessoryReference"
					}
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				},
				"memoryOptions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadMemoryOption"
					}
				},
				"overviewImages": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadOverviewImage"
					}
				}
			}
		},
		"ipadColor": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName", "images"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"finish": {
					"$ref": "#/$defs/finish",
					"description": "Finish record for the material swatch dot. Optional until backfill completes."
				},
				"images": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/ipadImage"
					}
				},
				"colorPriceAud": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"ipadImage": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "appleUrl", "localPath", "widthPx", "heightPx"],
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1
				},
				"appleUrl": {
					"type": "string",
					"format": "uri"
				},
				"localPath": {
					"type": "string",
					"minLength": 1
				},
				"widthPx": {
					"type": "integer",
					"minimum": 1
				},
				"heightPx": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"finish": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"base",
				"material"
			],
			"description": "Data-driven finish record. One generic renderer turns this into a material swatch dot (gradient + grain + shine, optional duo split). Never a per-finish asset or custom node.",
			"properties": {
				"base": {
					"type": "string",
					"pattern": "^#[0-9a-fA-F]{6}$",
					"description": "Anchor hex. Also the flat fallback render."
				},
				"material": {
					"enum": [
						"matte-aluminum",
						"brushed-titanium",
						"polished-titanium",
						"polished-steel",
						"ceramic",
						"glass",
						"fabric",
						"flat"
					],
					"description": "Surface recipe: sheen spread, glare, brushed streaks or weave are derived from this."
				},
				"sheen": {
					"type": "object",
					"additionalProperties": false,
					"description": "Optional specular override. Defaults come from material.",
					"properties": {
						"glareX": {
							"type": "number",
							"minimum": 0,
							"maximum": 100
						},
						"glareY": {
							"type": "number",
							"minimum": 0,
							"maximum": 100
						},
						"intensity": {
							"type": "number",
							"minimum": 0,
							"maximum": 1
						}
					}
				},
				"shine": {
					"type": "number",
					"minimum": 0,
					"maximum": 1,
					"description": "Crisp clearcoat hotspot + rim light. 0 none, 1 full glass-like pop. Defaults per material."
				},
				"grain": {
					"type": "number",
					"minimum": 0,
					"maximum": 1,
					"description": "Micro-noise overlay (parametric turbulence, no assets). Matte metals/ceramic low, fabric high."
				},
				"weave": {
					"type": "boolean",
					"description": "Parametric crosshatch overlay for woven fabric (e.g. HomePod mesh). Only meaningful with fabric material."
				},
				"duo": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"base",
						"material"
					],
					"description": "Second fill for two-tone split dots (e.g. Watch case + band). Grain/shine/sheen apply whole-dot.",
					"properties": {
						"base": {
							"type": "string",
							"pattern": "^#[0-9a-fA-F]{6}$"
						},
						"material": {
							"enum": [
								"matte-aluminum",
								"brushed-titanium",
								"polished-titanium",
								"polished-steel",
								"ceramic",
								"glass",
								"fabric",
								"flat"
							]
						},
						"split": {
							"type": "object",
							"additionalProperties": false,
							"description": "Divider geometry. Curve bows the line so it reads as Apple's photographic swoosh, not a straight diagonal.",
							"properties": {
								"angle": {
									"type": "number",
									"minimum": 0,
									"maximum": 360,
									"default": 135
								},
								"curve": {
									"type": "number",
									"minimum": -0.3,
									"maximum": 0.3,
									"default": 0.18
								},
								"offset": {
									"type": "number",
									"minimum": -0.5,
									"maximum": 0.5,
									"default": 0
								}
							}
						}
					}
				}
			}
		},
		"ipadStorageOption": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "capacityValue", "capacityUnit"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"minLength": 1
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"capacityValue": {
					"type": "integer",
					"minimum": 1
				},
				"capacityUnit": {
					"enum": ["GB", "TB"]
				},
				"priceDeltaAud": {
					"type": "number",
					"minimum": 0
				},
				"availableColorIds": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
						"minLength": 1
					}
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"ipadMemoryOption": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "capacityValue", "capacityUnit", "kind"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"minLength": 1
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"capacityValue": {
					"type": "integer",
					"minimum": 1
				},
				"capacityUnit": {
					"enum": ["GB", "TB"]
				},
				"kind": {
					"enum": ["unified", "DRAM", "NAND cache", "other"]
				},
				"speedMbps": {
					"type": "integer",
					"minimum": 0
				},
				"speedUnit": {
					"const": "Mbps"
				},
				"configuration": {
					"type": "string",
					"minLength": 1
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"ipadChip": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"displayName",
				"family",
				"cpuCores",
				"gpuCores",
				"neuralEngineCores",
				"memoryBandwidthGbps"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"minLength": 1
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"family": {
					"type": "string",
					"minLength": 1
				},
				"cpuCores": {
					"$ref": "#/$defs/ipadCpuCores"
				},
				"gpuCores": {
					"type": ["integer", "null"],
					"minimum": 0,
					"description": "Apple does not consistently publish GPU core counts for iPad chips in the supplied evidence; use explicit null only when the source omits it."
				},
				"neuralEngineCores": {
					"type": ["integer", "null"],
					"minimum": 0,
					"description": "Apple does not publish Neural Engine core counts for iPad chips in the supplied evidence; use explicit null only when the source omits it."
				},
				"memoryBandwidthGbps": {
					"type": ["number", "null"],
					"minimum": 0,
					"description": "Gigabits per second unless sourceNotes states bytes per second. Apple does not publish memory bandwidth for iPad chips; use explicit null only when the supplied evidence omits it."
				},
				"cpuCoreConfiguration": {
					"type": "string",
					"minLength": 1
				},
				"neuralAccelerators": {
					"type": "boolean"
				},
				"hardwareRayTracing": {
					"type": "boolean"
				},
				"mediaEngines": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadMediaEngine"
					}
				},
				"processNode": {
					"type": "string",
					"minLength": 1
				},
				"transistorCountBillions": {
					"type": "number",
					"minimum": 0
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"ipadDisplay": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"technology",
				"sizeIn",
				"resolutionWidthPx",
				"resolutionHeightPx",
				"pixelsPerInch"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"minLength": 1
				},
				"technology": {
					"type": "string",
					"minLength": 1
				},
				"panelKind": {
					"enum": [
						"LCD",
						"LED-backlit LCD",
						"OLED",
						"tandem OLED",
						"micro-OLED",
						"other"
					]
				},
				"sizeIn": {
					"type": "number",
					"minimum": 0,
					"description": "Inches"
				},
				"resolutionWidthPx": {
					"type": "integer",
					"minimum": 1
				},
				"resolutionHeightPx": {
					"type": "integer",
					"minimum": 1
				},
				"pixelsPerInch": {
					"type": "number",
					"minimum": 0
				},
				"refreshRateHz": {
					"type": "number",
					"minimum": 0
				},
				"refreshRateRange": {
					"$ref": "#/$defs/ipadMeasurementRange"
				},
				"sdrPeakBrightnessNits": {
					"type": "number",
					"minimum": 0
				},
				"hdrPeakBrightnessNits": {
					"type": "number",
					"minimum": 0
				},
				"fullScreenHdrBrightnessNits": {
					"type": "number",
					"minimum": 0
				},
				"minimumBrightnessNits": {
					"type": "number",
					"minimum": 0
				},
				"trueTone": {
					"type": "boolean"
				},
				"promotion": {
					"type": "boolean"
				},
				"alwaysOn": {
					"type": "boolean"
				},
				"wideColorP3": {
					"type": "boolean"
				},
				"laminated": {
					"type": "boolean"
				},
				"antireflective": {
					"type": "boolean"
				},
				"nanoTextureOption": {
					"type": "boolean"
				},
				"fingerprintResistantCoating": {
					"type": "boolean"
				},
				"hoverSupport": {
					"type": "boolean"
				},
				"mirroring": {
					"type": "boolean"
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"ipadCamera": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "role", "displayName", "megapixels"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"minLength": 1
				},
				"role": {
					"enum": [
						"rear-wide",
						"rear-ultrawide",
						"rear-telephoto",
						"front",
						"FaceTime",
						"spatial",
						"input-accessory",
						"other"
					]
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"megapixels": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"opticalZoomMultiplier": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"apertureFNumber": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"sensorShiftOis": {
					"type": "boolean"
				},
				"proRAW": {
					"type": "boolean"
				},
				"spatialCapture": {
					"type": "boolean"
				},
				"macro": {
					"type": "boolean"
				},
				"centerStage": {
					"type": "boolean"
				},
				"trueDepthSystem": {
					"type": "boolean"
				},
				"videoMaxResolutionWidthPx": {
					"type": "integer",
					"minimum": 1
				},
				"videoMaxResolutionHeightPx": {
					"type": "integer",
					"minimum": 1
				},
				"videoMaxFrameRateHz": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"proRes": {
					"type": "boolean"
				},
				"lidar": {
					"type": "boolean"
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"ipadAudio": {
			"type": "object",
			"additionalProperties": false,
			"required": ["speaker", "microphone"],
			"properties": {
				"speaker": {
					"type": "boolean"
				},
				"microphone": {
					"type": "boolean"
				},
				"speakerConfiguration": {
					"type": "string",
					"minLength": 1
				},
				"microphoneConfiguration": {
					"type": "string",
					"minLength": 1
				},
				"siren": {
					"type": "boolean"
				},
				"spatialAudio": {
					"type": "boolean"
				},
				"adaptiveAudio": {
					"type": "boolean"
				},
				"activeNoiseCancellation": {
					"type": "boolean"
				},
				"transparency": {
					"type": "boolean"
				},
				"formats": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"ipadBatteryAndPower": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"hasBattery",
				"batteryCapacityMah",
				"batteryCapacityWhr",
				"runtimeHours",
				"charging",
				"powerSupply"
			],
			"properties": {
				"hasBattery": {
					"type": "boolean"
				},
				"batteryCapacityMah": {
					"type": ["number", "null"],
					"minimum": 0,
					"description": "Apple does not publish iPad battery capacity in mAh in product specifications; use explicit null only when the supplied evidence omits it."
				},
				"batteryCapacityWhr": {
					"type": ["number", "null"],
					"minimum": 0,
					"description": "Apple does not publish iPad battery capacity in Whr in product specifications; use explicit null only when the supplied evidence omits it."
				},
				"runtimeHours": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/ipadBatteryRuntime"
					}
				},
				"charging": {
					"$ref": "#/$defs/ipadCharging"
				},
				"powerSupply": {
					"$ref": "#/$defs/ipadPowerSupply"
				}
			}
		},
		"ipadConnectivity": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"ports",
				"wifi",
				"bluetooth",
				"cellular",
				"uwb",
				"thread",
				"infrared",
				"nearFieldCommunication",
				"gps"
			],
			"properties": {
				"ports": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/ipadPort"
					}
				},
				"wifi": {
					"$ref": "#/$defs/ipadWifi"
				},
				"bluetooth": {
					"$ref": "#/$defs/ipadBluetooth"
				},
				"cellular": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadCellular"
						},
						{
							"type": "null"
						}
					],
					"description": "Explicit null records a device with no cellular hardware (e.g. a Wi-Fi-only model); use only when the hardware is absent."
				},
				"uwb": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadUwb"
						},
						{
							"type": "null"
						}
					],
					"description": "Explicit null records a device with no ultra-wideband hardware; use only when the hardware is absent."
				},
				"thread": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadThread"
						},
						{
							"type": "null"
						}
					],
					"description": "Explicit null records a device with no Thread radio; use only when the hardware is absent."
				},
				"infrared": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadInfrared"
						},
						{
							"type": "null"
						}
					],
					"description": "Explicit null records a device with no infrared hardware; use only when the hardware is absent."
				},
				"nearFieldCommunication": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadNearFieldCommunication"
						},
						{
							"type": "null"
						}
					],
					"description": "Explicit null records a device with no NFC hardware; use only when the hardware is absent."
				},
				"gps": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadGps"
						},
						{
							"type": "null"
						}
					],
					"description": "Explicit null records a device with no GPS hardware (e.g. a Wi-Fi-only model); use only when the hardware is absent."
				}
			}
		},
		"ipadAuthentication": {
			"type": "object",
			"additionalProperties": false,
			"required": ["methods", "primaryMethod"],
			"properties": {
				"methods": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"enum": [
							"Face ID",
							"Touch ID",
							"Optic ID",
							"passcode",
							"password",
							"none"
						]
					}
				},
				"primaryMethod": {
