{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://passionfruit.local/schemas/ipad.schema.json",
	"title": "Canonical iPad data",
	"type": "object",
	"additionalProperties": false,
	"required": ["devices"],
	"properties": {
		"devices": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/ipadDevice"
			}
		}
	},
	"$defs": {
		"ipadDevice": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"releaseYear",
				"priceAud",
				"colors",
				"configurations",
				"storageOptions",
				"chips",
				"displays",
				"cameras",
				"audio",
				"batteryAndPower",
				"connectivity",
				"authentication",
				"physical",
				"resistance",
				"software",
				"accessories",
				"sourceNotes",
				"memoryOptions"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
				},
				"name": {
					"type": "string"
				},
				"releaseYear": {
					"type": "integer",
					"minimum": 1976,
					"maximum": 2100
				},
				"priceAud": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"colors": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadColor"
					}
				},
				"configurations": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadConfiguration"
					}
				},
				"storageOptions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadStorageOption"
					}
				},
				"chips": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadChip"
					}
				},
				"displays": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadDisplay"
					}
				},
				"cameras": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadCamera"
					}
				},
				"audio": {
					"$ref": "#/$defs/ipadAudio"
				},
				"batteryAndPower": {
					"$ref": "#/$defs/ipadBatteryAndPower"
				},
				"connectivity": {
					"$ref": "#/$defs/ipadConnectivity"
				},
				"authentication": {
					"$ref": "#/$defs/ipadAuthentication"
				},
				"physical": {
					"$ref": "#/$defs/ipadPhysical"
				},
				"resistance": {
					"$ref": "#/$defs/ipadResistance"
				},
				"software": {
					"$ref": "#/$defs/ipadSoftware"
				},
				"accessories": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadAccessoryReference"
					}
				},
				"sourceNotes": {
					"type": "string"
				},
				"memoryOptions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadMemoryOption"
					}
				},
				"overviewImages": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadOverviewImage"
					}
				}
			}
		},
		"ipadColor": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName", "swatch", "images"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
				},
				"displayName": {
					"type": "string"
				},
				"swatch": {
					"$ref": "#/$defs/ipadSwatch"
				},
				"images": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadImage"
					}
				},
				"colorPriceAud": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"ipadImage": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "appleUrl", "localPath", "widthPx", "heightPx"],
			"properties": {
				"label": {
					"type": "string"
				},
				"appleUrl": {
					"type": "string",
					"format": "uri"
				},
				"localPath": {
					"type": "string"
				},
				"widthPx": {
					"type": "integer",
					"minimum": 1
				},
				"heightPx": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"ipadSwatch": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "value"],
					"properties": {
						"kind": {
							"const": "css"
						},
						"value": {
							"type": "string",
							"pattern": "^#[0-9a-fA-F]{6}$|^#[0-9a-fA-F]{8}$|^rgba?\\("
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "url"],
					"properties": {
						"kind": {
							"const": "image"
						},
						"url": {
							"type": "string",
							"format": "uri"
						}
					}
				}
			]
		},
		"ipadStorageOption": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "capacityValue", "capacityUnit"],
			"properties": {
				"id": {
					"type": "string"
				},
				"displayName": {
					"type": "string"
				},
				"capacityValue": {
					"type": "integer",
					"minimum": 1
				},
				"capacityUnit": {
					"enum": ["GB", "TB"]
				},
				"priceDeltaAud": {
					"type": "number"
				},
				"availableColorIds": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"ipadMemoryOption": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "capacityValue", "capacityUnit", "kind"],
			"properties": {
				"id": {
					"type": "string"
				},
				"displayName": {
					"type": "string"
				},
				"capacityValue": {
					"type": "integer",
					"minimum": 1
				},
				"capacityUnit": {
					"enum": ["GB", "TB"]
				},
				"kind": {
					"enum": ["unified", "DRAM", "NAND cache", "other"]
				},
				"speedMbps": {
					"type": "integer"
				},
				"speedUnit": {
					"const": "Mbps"
				},
				"configuration": {
					"type": "string"
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"ipadChip": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"displayName",
				"family",
				"cpuCores",
				"gpuCores",
				"neuralEngineCores",
				"memoryBandwidthGbps"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"displayName": {
					"type": "string"
				},
				"family": {
					"type": "string"
				},
				"cpuCores": {
					"$ref": "#/$defs/ipadCpuCores"
				},
				"gpuCores": {
					"type": ["integer", "null"],
					"minimum": 0
				},
				"neuralEngineCores": {
					"type": ["integer", "null"],
					"minimum": 0
				},
				"memoryBandwidthGbps": {
					"type": ["number", "null"],
					"minimum": 0,
					"description": "Gigabits per second unless sourceNotes states bytes per second."
				},
				"cpuCoreConfiguration": {
					"type": "string"
				},
				"neuralAccelerators": {
					"type": "boolean"
				},
				"hardwareRayTracing": {
					"type": "boolean"
				},
				"mediaEngines": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadMediaEngine"
					}
				},
				"processNode": {
					"type": "string"
				},
				"transistorCountBillions": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"ipadDisplay": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"technology",
				"sizeIn",
				"resolutionWidthPx",
				"resolutionHeightPx",
				"pixelsPerInch"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"technology": {
					"type": "string"
				},
				"panelKind": {
					"enum": [
						"LCD",
						"LED-backlit LCD",
						"OLED",
						"tandem OLED",
						"micro-OLED",
						"other",
						null
					]
				},
				"sizeIn": {
					"type": ["number", "null"],
					"minimum": 0,
					"description": "Inches"
				},
				"resolutionWidthPx": {
					"type": ["integer", "null"],
					"minimum": 1
				},
				"resolutionHeightPx": {
					"type": ["integer", "null"],
					"minimum": 1
				},
				"pixelsPerInch": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"refreshRateHz": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"refreshRateRange": {
					"$ref": "#/$defs/ipadMeasurementRange"
				},
				"sdrPeakBrightnessNits": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"hdrPeakBrightnessNits": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"fullScreenHdrBrightnessNits": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"minimumBrightnessNits": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"trueTone": {
					"type": "boolean"
				},
				"promotion": {
					"type": "boolean"
				},
				"alwaysOn": {
					"type": "boolean"
				},
				"wideColorP3": {
					"type": "boolean"
				},
				"laminated": {
					"type": "boolean"
				},
				"antireflective": {
					"type": "boolean"
				},
				"nanoTextureOption": {
					"type": "boolean"
				},
				"fingerprintResistantCoating": {
					"type": "boolean"
				},
				"hoverSupport": {
					"type": "boolean"
				},
				"mirroring": {
					"type": "boolean"
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"ipadCamera": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "role", "displayName", "megapixels"],
			"properties": {
				"id": {
					"type": "string"
				},
				"role": {
					"enum": [
						"rear-wide",
						"rear-ultrawide",
						"rear-telephoto",
						"front",
						"FaceTime",
						"spatial",
						"input-accessory",
						"other"
					]
				},
				"displayName": {
					"type": "string"
				},
				"megapixels": {
					"type": ["number", "null"],
					"exclusiveMinimum": 0
				},
				"opticalZoomMultiplier": {
					"type": ["number", "null"],
					"exclusiveMinimum": 0
				},
				"apertureFNumber": {
					"type": ["number", "null"],
					"exclusiveMinimum": 0
				},
				"sensorShiftOis": {
					"type": "boolean"
				},
				"proRAW": {
					"type": "boolean"
				},
				"spatialCapture": {
					"type": "boolean"
				},
				"macro": {
					"type": "boolean"
				},
				"centerStage": {
					"type": "boolean"
				},
				"trueDepthSystem": {
					"type": "boolean"
				},
				"videoMaxResolutionWidthPx": {
					"type": ["integer", "null"],
					"minimum": 1
				},
				"videoMaxResolutionHeightPx": {
					"type": ["integer", "null"],
					"minimum": 1
				},
				"videoMaxFrameRateHz": {
					"type": ["number", "null"],
					"exclusiveMinimum": 0
				},
				"proRes": {
					"type": "boolean"
				},
				"lidar": {
					"type": "boolean"
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"ipadAudio": {
			"type": "object",
			"additionalProperties": false,
			"required": ["speaker", "microphone"],
			"properties": {
				"speaker": {
					"type": "boolean"
				},
				"microphone": {
					"type": "boolean"
				},
				"speakerConfiguration": {
					"type": "string"
				},
				"microphoneConfiguration": {
					"type": "string"
				},
				"siren": {
					"type": "boolean"
				},
				"spatialAudio": {
					"type": "boolean"
				},
				"adaptiveAudio": {
					"type": "boolean"
				},
				"activeNoiseCancellation": {
					"type": "boolean"
				},
				"transparency": {
					"type": "boolean"
				},
				"formats": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"ipadBatteryAndPower": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"hasBattery",
				"batteryCapacityMah",
				"batteryCapacityWhr",
				"runtimeHours",
				"charging",
				"powerSupply"
			],
			"properties": {
				"hasBattery": {
					"type": "boolean"
				},
				"batteryCapacityMah": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"batteryCapacityWhr": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"runtimeHours": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadBatteryRuntime"
					}
				},
				"charging": {
					"$ref": "#/$defs/ipadCharging"
				},
				"powerSupply": {
					"$ref": "#/$defs/ipadPowerSupply"
				}
			}
		},
		"ipadConnectivity": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"ports",
				"wifi",
				"bluetooth",
				"cellular",
				"uwb",
				"thread",
				"infrared",
				"nearFieldCommunication",
				"gps"
			],
			"properties": {
				"ports": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadPort"
					}
				},
				"wifi": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadWifi"
						},
						{
							"type": "null"
						}
					]
				},
				"bluetooth": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadBluetooth"
						},
						{
							"type": "null"
						}
					]
				},
				"cellular": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadCellular"
						},
						{
							"type": "null"
						}
					]
				},
				"uwb": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadUwb"
						},
						{
							"type": "null"
						}
					]
				},
				"thread": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadThread"
						},
						{
							"type": "null"
						}
					]
				},
				"infrared": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadInfrared"
						},
						{
							"type": "null"
						}
					]
				},
				"nearFieldCommunication": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadNearFieldCommunication"
						},
						{
							"type": "null"
						}
					]
				},
				"gps": {
					"anyOf": [
						{
							"$ref": "#/$defs/ipadGps"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"ipadAuthentication": {
			"type": "object",
			"additionalProperties": false,
			"required": ["methods", "primaryMethod"],
			"properties": {
				"methods": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"enum": [
							"Face ID",
							"Touch ID",
							"Optic ID",
							"passcode",
							"password",
							"none"
						]
					}
				},
				"primaryMethod": {
					"enum": [
						"Face ID",
						"Touch ID",
						"Optic ID",
						"passcode",
						"password",
						"none"
					]
				},
				"placement": {
					"enum": ["top button", "keyboard", "side button", "other", null]
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"ipadPhysical": {
			"type": "object",
			"additionalProperties": false,
			"required": ["weights", "dimensions", "components"],
			"properties": {
				"weights": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadMeasurement"
					}
				},
				"dimensions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadMeasurement"
					}
				},
				"components": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ipadPhysicalComponent"
					}
				}
			}
		},
		"ipadResistance": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"ipRating",
				"waterDepthM",
				"splashPressureAtm",
				"dustProtected",
				"sweatResistant"
			],
			"properties": {
				"ipRating": {
					"type": ["string", "null"],
					"pattern": "^(IP[0-9]X?|IP6X|IP68)$|^$|^null$"
				},
				"waterDepthM": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"splashPressureAtm": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"dustProtected": {
					"type": "boolean"
				},
				"sweatResistant": {
					"type": "boolean"
				}
			}
		},
		"ipadSoftware": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"operatingSystem",
				"operatingSystemVersionAtLaunch",
				"builtInApps"
			],
			"properties": {
				"operatingSystem": {
					"type": "string"
				},
				"operatingSystemVersionAtLaunch": {
					"type": ["string", "null"]
				},
				"compatibleOperatingSystems": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"builtInApps": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"ipadOverviewImage": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "appleUrl", "localPath", "widthPx", "heightPx"],
			"properties": {
				"label": {
					"type": "string"
				},
				"appleUrl": {
					"type": "string"
				},
				"localPath": {
					"type": "string"
				},
				"widthPx": {
					"type": "integer",
					"minimum": 1
				},
				"heightPx": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"ipadCpuCores": {
			"type": "object",
			"additionalProperties": false,
			"required": ["total", "performance", "efficiency"],
			"properties": {
				"total": {
					"type": "integer",
					"minimum": 1
				},
				"performance": {
					"type": ["integer", "null"],
					"minimum": 0
				},
				"efficiency": {
					"type": ["integer", "null"],
					"minimum": 0
				}
			}
		},
		"ipadMediaEngine": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName", "kinds"],
			"properties": {
				"id": {
					"type": "string"
				},
				"displayName": {
					"type": "string"
				},
				"kinds": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"enum": [
							"video-decode",
							"video-encode",
							"ProRes encode-decode",
							"image signal",
							"AV1 decode",
							"other"
						]
					}
				}
			}
		},
		"ipadMeasurementRange": {
			"type": "object",
			"additionalProperties": false,
			"required": ["minimum", "maximum", "unit"],
			"properties": {
				"minimum": {
					"type": "number"
				},
				"maximum": {
					"type": "number"
				},
				"unit": {
					"type": "string",
					"enum": [
						"mm",
						"cm",
						"m",
						"in",
