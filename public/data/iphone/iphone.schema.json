{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://passionfruit.local/schemas/iphone.schema.json",
	"title": "Canonical iPhone data",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"devices"
	],
	"properties": {
		"devices": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/iphoneDevice"
			}
		}
	},
	"$defs": {
		"iphoneDevice": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"releaseYear",
				"priceAud",
				"colors",
				"configurations",
				"storageOptions",
				"chips",
				"displays",
				"cameras",
				"audio",
				"batteryAndPower",
				"connectivity",
				"authentication",
				"physical",
				"resistance",
				"software",
				"accessories",
				"sourceNotes"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"minLength": 1
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"releaseYear": {
					"type": "integer",
					"minimum": 1976,
					"maximum": 2100
				},
				"priceAud": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"colors": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/iphoneColor"
					}
				},
				"configurations": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/iphoneConfiguration"
					}
				},
				"storageOptions": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/iphoneStorageOption"
					}
				},
				"chips": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/iphoneChip"
					}
				},
				"displays": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/iphoneDisplay"
					}
				},
				"cameras": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/iphoneCamera"
					}
				},
				"audio": {
					"$ref": "#/$defs/iphoneAudio"
				},
				"batteryAndPower": {
					"$ref": "#/$defs/iphoneBatteryAndPower"
				},
				"connectivity": {
					"$ref": "#/$defs/iphoneConnectivity"
				},
				"authentication": {
					"$ref": "#/$defs/iphoneAuthentication"
				},
				"physical": {
					"$ref": "#/$defs/iphonePhysical"
				},
				"resistance": {
					"$ref": "#/$defs/iphoneResistance"
				},
				"software": {
					"$ref": "#/$defs/iphoneSoftware"
				},
				"accessories": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/iphoneAccessoryReference"
					}
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				},
				"memoryOptions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/iphoneMemoryOption"
					}
				},
				"overviewImages": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/iphoneOverviewImage"
					}
				},
				"ceramicShieldFront": {
					"enum": [
						"none",
						"1",
						"2"
					],
					"description": "Ceramic Shield generation protecting the front of the phone. Use \"none\" when no Ceramic Shield is present."
				},
				"ceramicShieldBack": {
					"enum": [
						"none",
						"1",
						"2"
					],
					"description": "Ceramic Shield generation protecting the back of the phone. Use \"none\" when no Ceramic Shield is present."
				},
				"isFolding": {
					"type": "boolean",
					"description": "True for folding phones such as iPhone Duo."
				},
				"applePencilSupport": {
					"type": "boolean",
					"description": "True when the iPhone supports Apple Pencil input. Only iPhone Duo supports this to date."
				}
			}
		},
		"iphoneColor": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"displayName",
				"swatch",
				"images"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"swatch": {
					"$ref": "#/$defs/iphoneSwatch"
				},
				"images": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/iphoneImage"
					}
				},
				"colorPriceAud": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"iphoneImage": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"label",
				"appleUrl",
				"localPath",
				"widthPx",
				"heightPx"
			],
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1
				},
				"appleUrl": {
					"type": "string",
					"format": "uri",
					"minLength": 1
				},
				"localPath": {
					"type": "string",
					"minLength": 1
				},
				"widthPx": {
					"type": "integer",
					"minimum": 1
				},
				"heightPx": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"iphoneSwatch": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": [
						"kind",
						"value"
					],
					"properties": {
						"kind": {
							"const": "css"
						},
						"value": {
							"type": "string",
							"pattern": "^#[0-9a-fA-F]{6}$|^#[0-9a-fA-F]{8}$|^rgba?\\("
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": [
						"kind",
						"url"
					],
					"properties": {
						"kind": {
							"const": "image"
						},
						"url": {
							"type": "string",
							"format": "uri"
						}
					}
				}
			]
		},
		"iphoneStorageOption": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"capacityValue",
				"capacityUnit"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"minLength": 1
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"capacityValue": {
					"type": "integer",
					"minimum": 1
				},
				"capacityUnit": {
					"enum": [
						"GB",
						"TB"
					]
				},
				"priceDeltaAud": {
					"type": "number",
					"minimum": 0
				},
				"availableColorIds": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
						"minLength": 1
					}
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"iphoneMemoryOption": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"capacityValue",
				"capacityUnit",
				"kind"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"minLength": 1
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"capacityValue": {
					"type": "integer",
					"minimum": 1
				},
				"capacityUnit": {
					"enum": [
						"GB",
						"TB"
					]
				},
				"kind": {
					"enum": [
						"unified",
						"DRAM",
						"NAND cache",
						"other"
					]
				},
				"speedMbps": {
					"type": "integer",
					"exclusiveMinimum": 0
				},
				"speedUnit": {
					"const": "Mbps"
				},
				"configuration": {
					"type": "string",
					"minLength": 1
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"iphoneChip": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"displayName",
				"family",
				"cpuCores",
				"gpuCores",
				"neuralEngineCores",
				"memoryBandwidthGbps"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"minLength": 1
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"family": {
					"type": "string",
					"minLength": 1
				},
				"cpuCores": {
					"$ref": "#/$defs/iphoneCpuCores"
				},
				"gpuCores": {
					"type": "integer",
					"minimum": 0
				},
				"neuralEngineCores": {
					"type": "integer",
					"minimum": 0
				},
				"memoryBandwidthGbps": {
					"type": [
						"number",
						"null"
					],
					"minimum": 0,
					"description": "Gigabits per second unless sourceNotes states bytes per second. Apple does not publish iPhone SoC memory bandwidth; use null when unpublished."
				},
				"cpuCoreConfiguration": {
					"type": "string",
					"minLength": 1
				},
				"neuralAccelerators": {
					"type": "boolean"
				},
				"hardwareRayTracing": {
					"type": "boolean"
				},
				"mediaEngines": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/iphoneMediaEngine"
					}
				},
				"processNode": {
					"type": "string",
					"minLength": 1
				},
				"transistorCountBillions": {
					"type": "number",
					"minimum": 0
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"iphoneDisplay": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"technology",
				"sizeIn",
				"resolutionWidthPx",
				"resolutionHeightPx",
				"pixelsPerInch"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"minLength": 1
				},
				"technology": {
					"type": "string",
					"minLength": 1
				},
				"panelKind": {
					"enum": [
						"LCD",
						"LED-backlit LCD",
						"OLED",
						"tandem OLED",
						"micro-OLED",
						"other"
					]
				},
				"sizeIn": {
					"type": "number",
					"minimum": 0,
					"description": "Inches"
				},
				"resolutionWidthPx": {
					"type": "integer",
					"minimum": 1
				},
				"resolutionHeightPx": {
					"type": "integer",
					"minimum": 1
				},
				"pixelsPerInch": {
					"type": "number",
					"minimum": 0
				},
				"refreshRateHz": {
					"type": "number",
					"minimum": 0
				},
				"refreshRateRange": {
					"$ref": "#/$defs/iphoneMeasurementRange"
				},
				"sdrPeakBrightnessNits": {
					"type": "number",
					"minimum": 0
				},
				"hdrPeakBrightnessNits": {
					"type": "number",
					"minimum": 0
				},
				"fullScreenHdrBrightnessNits": {
					"type": "number",
					"minimum": 0
				},
				"minimumBrightnessNits": {
					"type": "number",
					"minimum": 0
				},
				"trueTone": {
					"type": "boolean"
				},
				"promotion": {
					"type": "boolean"
				},
				"alwaysOn": {
					"type": "boolean"
				},
				"wideColorP3": {
					"type": "boolean"
				},
				"laminated": {
					"type": "boolean"
				},
				"antireflective": {
					"type": "boolean"
				},
				"nanoTextureOption": {
					"type": "boolean"
				},
				"fingerprintResistantCoating": {
					"type": "boolean"
				},
				"hoverSupport": {
					"type": "boolean"
				},
				"mirroring": {
					"type": "boolean"
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"iphoneCamera": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"role",
				"displayName",
				"megapixels"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"minLength": 1
				},
				"role": {
					"enum": [
						"rear-wide",
						"rear-ultrawide",
						"rear-telephoto",
						"front",
						"FaceTime",
						"spatial",
						"input-accessory",
						"other"
					]
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"megapixels": {
					"type": [
						"number",
						"null"
					],
					"exclusiveMinimum": 0,
					"description": "Megapixels. Null only when the manufacturer publishes no still-photo resolution (documented case: under-display FaceTime cameras with video-only specs)."
				},
				"opticalZoomMultiplier": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"apertureFNumber": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"sensorShiftOis": {
					"type": "boolean"
				},
				"proRAW": {
					"type": "boolean"
				},
				"spatialCapture": {
					"type": "boolean"
				},
				"macro": {
					"type": "boolean"
				},
				"centerStage": {
					"type": "boolean"
				},
				"trueDepthSystem": {
					"type": "boolean"
				},
				"videoMaxResolutionWidthPx": {
					"type": "integer",
					"minimum": 1
				},
				"videoMaxResolutionHeightPx": {
					"type": "integer",
					"minimum": 1
				},
				"videoMaxFrameRateHz": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"proRes": {
					"type": "boolean"
				},
				"lidar": {
					"type": "boolean"
				},
				"variableAperture": {
					"type": "boolean",
					"description": "True when the main camera supports variable aperture."
				},
				"appleReferenceImageSupport": {
					"type": "boolean",
					"description": "True when the main camera supports Apple Reference Image output."
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"iphoneAudio": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"speaker",
				"microphone"
			],
			"properties": {
				"speaker": {
					"type": "boolean"
				},
				"microphone": {
					"type": "boolean"
				},
				"speakerConfiguration": {
					"type": "string",
					"minLength": 1
				},
				"microphoneConfiguration": {
					"type": "string",
					"minLength": 1
				},
				"siren": {
					"type": "boolean"
				},
				"spatialAudio": {
					"type": "boolean"
				},
				"adaptiveAudio": {
					"type": "boolean"
				},
				"activeNoiseCancellation": {
					"type": "boolean"
				},
				"transparency": {
					"type": "boolean"
				},
				"formats": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"iphoneBatteryAndPower": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"hasBattery",
				"batteryCapacityMah",
				"batteryCapacityWhr",
				"runtimeHours",
				"charging",
				"powerSupply"
			],
			"properties": {
				"hasBattery": {
					"type": "boolean"
				},
				"batteryCapacityMah": {
					"type": [
						"number",
						"null"
					],
					"minimum": 0,
					"description": "Milliampere-hours. Apple does not publish iPhone battery capacities; use null when unpublished."
				},
				"batteryCapacityWhr": {
					"type": [
						"number",
						"null"
					],
					"minimum": 0,
					"description": "Watt-hours. Apple does not publish iPhone battery energy capacity; use null when unpublished."
				},
				"runtimeHours": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/iphoneBatteryRuntime"
					}
				},
				"charging": {
					"$ref": "#/$defs/iphoneCharging"
				},
				"powerSupply": {
					"$ref": "#/$defs/iphonePowerSupply"
				}
			}
		},
		"iphoneConnectivity": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"ports",
				"wifi",
				"bluetooth",
				"cellular",
				"uwb",
				"thread",
				"infrared",
				"nearFieldCommunication",
				"gps"
			],
			"properties": {
				"ports": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/iphonePort"
					}
				},
				"wifi": {
					"$ref": "#/$defs/iphoneWifi"
				},
				"bluetooth": {
					"$ref": "#/$defs/iphoneBluetooth"
				},
				"cellular": {
					"$ref": "#/$defs/iphoneCellular"
				},
				"uwb": {
					"$ref": "#/$defs/iphoneUwb"
				},
				"thread": {
					"$ref": "#/$defs/iphoneThread"
				},
				"infrared": {
					"$ref": "#/$defs/iphoneInfrared"
				},
				"nearFieldCommunication": {
					"$ref": "#/$defs/iphoneNearFieldCommunication"
				},
				"gps": {
					"$ref": "#/$defs/iphoneGps"
				}
			}
		},
		"iphoneAuthentication": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"methods",
				"primaryMethod"
			],
			"properties": {
				"methods": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"enum": [
							"Face ID",
							"Touch ID",
							"Optic ID",
							"passcode",
							"password",
							"none"
						]
					}
				},
				"primaryMethod": {
					"enum": [
						"Face ID",
						"Touch ID",
						"Optic ID",
						"passcode",
						"password",
						"none"
					]
				},
				"placement": {
					"enum": [
						"top button",
						"keyboard",
						"side button",
						"other"
					]
				},
				"sourceNotes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"iphonePhysical": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"weights",
				"dimensions",
				"components"
			],
			"properties": {
				"weights": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/iphoneMeasurement"
					}
				},
				"dimensions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/iphoneMeasurement"
					}
				},
				"components": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/iphonePhysicalComponent"
					}
				}
			}
		},
		"iphoneResistance": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"ipRating",
				"waterDepthM",
				"splashPressureAtm",
				"dustProtected",
				"sweatResistant"
			],
			"properties": {
				"ipRating": {
					"type": "string",
					"pattern": "^(IP[0-9A-Z]+|WR[0-9]+.*)$"
				},
				"waterDepthM": {
					"type": "number",
					"minimum": 0
				},
				"splashPressureAtm": {
					"type": [
						"number",
						"null"
					],
					"minimum": 0,
					"description": "Atmospheres. Apple publishes no splash-pressure figures for iPhones; use null when unpublished."
				},
				"dustProtected": {
					"type": "boolean"
				},
				"sweatResistant": {
					"type": "boolean"
				}
			}
		},
		"iphoneSoftware": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"operatingSystem",
