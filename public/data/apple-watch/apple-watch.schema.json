{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://passionfruit.local/schemas/data-model-contract.schema.json",
	"title": "Canonical Apple device data-model fragments and concrete examples",
	"type": "object",
	"additionalProperties": false,
	"required": ["devices"],
	"properties": {
		"devices": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/productCollectionDiscriminator"
			}
		}
	},
	"$defs": {
		"measurement": {
			"type": "object",
			"additionalProperties": false,
			"required": ["value", "unit"],
			"properties": {
				"value": {
					"type": ["number", "null"]
				},
				"unit": {
					"type": "string",
					"enum": [
						"mm",
						"cm",
						"m",
						"in",
						"g",
						"kg",
						"oz",
						"lb",
						"nits",
						"hz",
						"w",
						"v",
						"a",
						"mAh",
						"Whr",
						"hours",
						"minutes",
						"percent",
						"GB",
						"TB",
						"Mbps",
						"Gbps",
						"dB SPL",
						"atm"
					]
				},
				"qualifier": {
					"type": "string"
				}
			}
		},
		"measurementRange": {
			"type": "object",
			"additionalProperties": false,
			"required": ["minimum", "maximum", "unit"],
			"properties": {
				"minimum": {
					"type": "number"
				},
				"maximum": {
					"type": "number"
				},
				"unit": {
					"type": "string",
					"enum": [
						"mm",
						"cm",
						"m",
						"in",
						"g",
						"kg",
						"oz",
						"lb",
						"nits",
						"hz",
						"w",
						"v",
						"a",
						"mAh",
						"Whr",
						"hours",
						"minutes",
						"percent",
						"GB",
						"TB",
						"Mbps",
						"Gbps",
						"dB SPL",
						"atm"
					]
				},
				"qualifier": {
					"type": "string"
				}
			}
		},
		"swatch": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "value"],
					"properties": {
						"kind": {
							"const": "css"
						},
						"value": {
							"type": "string",
							"pattern": "^#[0-9a-fA-F]{6}$|^#[0-9a-fA-F]{8}$|^rgba?\\("
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "url"],
					"properties": {
						"kind": {
							"const": "image"
						},
						"url": {
							"type": "string",
							"format": "uri"
						}
					}
				}
			]
		},
		"image": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "appleUrl", "localPath", "widthPx", "heightPx"],
			"properties": {
				"label": {
					"type": "string"
				},
				"appleUrl": {
					"type": "string",
					"format": "uri"
				},
				"localPath": {
					"type": "string"
				},
				"widthPx": {
					"type": "integer",
					"minimum": 1
				},
				"heightPx": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"color": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName", "swatch", "images"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
				},
				"displayName": {
					"type": "string"
				},
				"swatch": {
					"$ref": "#/$defs/swatch"
				},
				"images": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/image"
					}
				},
				"colorPriceAud": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"storageOption": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "capacityValue", "capacityUnit"],
			"properties": {
				"id": {
					"type": "string"
				},
				"displayName": {
					"type": "string"
				},
				"capacityValue": {
					"type": "integer",
					"minimum": 1
				},
				"capacityUnit": {
					"enum": ["GB", "TB"]
				},
				"priceDeltaAud": {
					"type": "number"
				},
				"availableColorIds": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"memoryOption": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "capacityValue", "capacityUnit", "kind"],
			"properties": {
				"id": {
					"type": "string"
				},
				"displayName": {
					"type": "string"
				},
				"capacityValue": {
					"type": "integer",
					"minimum": 1
				},
				"capacityUnit": {
					"enum": ["GB", "TB"]
				},
				"kind": {
					"enum": ["unified", "DRAM", "NAND cache", "other"]
				},
				"speedMbps": {
					"type": "integer"
				},
				"speedUnit": {
					"const": "Mbps"
				},
				"configuration": {
					"type": "string"
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"port": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "kind"],
			"properties": {
				"id": {
					"type": "string"
				},
				"kind": {
					"enum": [
						"USB-C",
						"Thunderbolt 4",
						"Thunderbolt 5",
						"Lightning",
						"HDMI",
						"Ethernet RJ45",
						"IR receiver",
						"power connector",
						"3.5 mm audio jack",
						"Smart Connector",
						"proprietary"
					]
				},
				"standard": {
					"enum": [
						"USB 2",
						"USB 3.2 Gen 1",
						"USB 4",
						"Thunderbolt 3",
						"Thunderbolt 4",
						"Thunderbolt 5"
					]
				},
				"quantity": {
					"type": "integer",
					"minimum": 1
				},
				"supportsDisplayOut": {
					"type": ["boolean", "null"]
				},
				"maxPowerW": {
					"type": ["number", "null"],
					"description": "Watts"
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"cpuCores": {
			"type": "object",
			"additionalProperties": false,
			"required": ["total", "performance", "efficiency"],
			"properties": {
				"total": {
					"type": "integer",
					"minimum": 1
				},
				"performance": {
					"type": ["integer", "null"],
					"minimum": 0
				},
				"efficiency": {
					"type": ["integer", "null"],
					"minimum": 0
				}
			}
		},
		"mediaEngine": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName", "kinds"],
			"properties": {
				"id": {
					"type": "string"
				},
				"displayName": {
					"type": "string"
				},
				"kinds": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"enum": [
							"video-decode",
							"video-encode",
							"ProRes encode-decode",
							"image signal",
							"AV1 decode",
							"other"
						]
					}
				}
			}
		},
		"chip": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"displayName",
				"family",
				"cpuCores",
				"gpuCores",
				"neuralEngineCores",
				"memoryBandwidthGbps"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"displayName": {
					"type": "string"
				},
				"family": {
					"type": "string"
				},
				"cpuCores": {
					"$ref": "#/$defs/cpuCores"
				},
				"gpuCores": {
					"type": ["integer", "null"],
					"minimum": 0
				},
				"neuralEngineCores": {
					"type": ["integer", "null"],
					"minimum": 0
				},
				"memoryBandwidthGbps": {
					"type": ["number", "null"],
					"minimum": 0,
					"description": "Gigabits per second unless sourceNotes states bytes per second."
				},
				"cpuCoreConfiguration": {
					"type": "string"
				},
				"neuralAccelerators": {
					"type": "boolean"
				},
				"hardwareRayTracing": {
					"type": ["boolean", "null"]
				},
				"mediaEngines": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/mediaEngine"
					}
				},
				"processNode": {
					"type": "string"
				},
				"transistorCountBillions": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"display": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"technology",
				"sizeIn",
				"resolutionWidthPx",
				"resolutionHeightPx",
				"pixelsPerInch"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"technology": {
					"type": "string"
				},
				"panelKind": {
					"enum": [
						"LCD",
						"LED-backlit LCD",
						"OLED",
						"tandem OLED",
						"micro-OLED",
						"other",
						null
					]
				},
				"sizeIn": {
					"type": ["number", "null"],
					"minimum": 0,
					"description": "Inches"
				},
				"resolutionWidthPx": {
					"type": ["integer", "null"],
					"minimum": 1
				},
				"resolutionHeightPx": {
					"type": ["integer", "null"],
					"minimum": 1
				},
				"pixelsPerInch": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"refreshRateHz": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"refreshRateRange": {
					"$ref": "#/$defs/measurementRange"
				},
				"sdrPeakBrightnessNits": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"hdrPeakBrightnessNits": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"fullScreenHdrBrightnessNits": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"minimumBrightnessNits": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"trueTone": {
					"type": ["boolean", "null"]
				},
				"promotion": {
					"type": ["boolean", "null"]
				},
				"alwaysOn": {
					"type": ["boolean", "null"]
				},
				"wideColorP3": {
					"type": ["boolean", "null"]
				},
				"laminated": {
					"type": ["boolean", "null"]
				},
				"antireflective": {
					"type": ["boolean", "null"]
				},
				"nanoTextureOption": {
					"type": ["boolean", "null"]
				},
				"fingerprintResistantCoating": {
					"type": ["boolean", "null"]
				},
				"hoverSupport": {
					"type": ["boolean", "null"]
				},
				"mirroring": {
					"type": ["boolean", "null"]
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"camera": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "role", "displayName", "megapixels"],
			"properties": {
				"id": {
					"type": "string"
				},
				"role": {
					"enum": [
						"rear-wide",
						"rear-ultrawide",
						"rear-telephoto",
						"front",
						"FaceTime",
						"spatial",
						"input-accessory",
						"other"
					]
				},
				"displayName": {
					"type": "string"
				},
				"megapixels": {
					"type": ["number", "null"],
					"exclusiveMinimum": 0
				},
				"opticalZoomMultiplier": {
					"type": ["number", "null"],
					"exclusiveMinimum": 0
				},
				"apertureFNumber": {
					"type": ["number", "null"],
					"exclusiveMinimum": 0
				},
				"sensorShiftOis": {
					"type": ["boolean", "null"]
				},
				"proRAW": {
					"type": ["boolean", "null"]
				},
				"spatialCapture": {
					"type": ["boolean", "null"]
				},
				"macro": {
					"type": ["boolean", "null"]
				},
				"centerStage": {
					"type": ["boolean", "null"]
				},
				"trueDepthSystem": {
					"type": ["boolean", "null"]
				},
				"videoMaxResolutionWidthPx": {
					"type": ["integer", "null"],
					"minimum": 1
				},
				"videoMaxResolutionHeightPx": {
					"type": ["integer", "null"],
					"minimum": 1
				},
				"videoMaxFrameRateHz": {
					"type": ["number", "null"],
					"exclusiveMinimum": 0
				},
				"proRes": {
					"type": ["boolean", "null"]
				},
				"lidar": {
					"type": ["boolean", "null"]
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"audio": {
			"type": "object",
			"additionalProperties": false,
			"required": ["speaker", "microphone"],
			"properties": {
				"speaker": {
					"type": ["boolean", "null"]
				},
				"microphone": {
					"type": ["boolean", "null"]
				},
				"speakerConfiguration": {
					"type": "string"
				},
				"microphoneConfiguration": {
					"type": "string"
				},
				"siren": {
					"type": ["boolean", "null"]
				},
				"spatialAudio": {
					"type": ["boolean", "null"]
				},
				"adaptiveAudio": {
					"type": ["boolean", "null"]
				},
				"activeNoiseCancellation": {
					"type": ["boolean", "null"]
				},
				"transparency": {
					"type": ["boolean", "null"]
				},
				"formats": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"sourceNotes": {
					"type": "string"
				}
			}
		},
		"batteryRuntime": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "activity", "hours"],
			"properties": {
				"id": {
					"type": "string"
				},
				"activity": {
					"type": "string"
				},
				"hours": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"qualifier": {
					"type": "string"
				},
				"network": {
					"enum": ["Wi-Fi", "cellular", "offline", null]
				}
			}
		},
		"charging": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"portId",
				"wiredFastCharge",
				"wirelessCharging",
				"wirelessStandards",
				"fastChargeMinutesToPercent",
				"adapterPowerW"
			],
			"properties": {
				"portId": {
					"type": ["string", "null"]
				},
				"wiredFastCharge": {
					"type": ["boolean", "null"]
				},
				"wirelessCharging": {
					"type": ["boolean", "null"]
				},
				"wirelessStandards": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"type": "array",
							"uniqueItems": true,
							"items": {
								"enum": ["MagSafe", "Qi", "Qi2", "inductive", "other"]
							}
						}
					]
				},
				"fastChargeMinutesToPercent": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["minutes", "percent"],
							"properties": {
								"minutes": {
									"type": "number",
									"minimum": 0
								},
								"percent": {
									"type": "number",
									"minimum": 0,
									"maximum": 100
								}
							}
						}
					]
				},
				"adapterPowerW": {
					"type": ["number", "null"],
					"minimum": 0
				}
			}
		},
		"powerSupply": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"hasExternalPowerAdapter",
				"outputVoltageV",
				"outputCurrentA",
				"outputPowerW",
				"inputVoltageRangeV",
				"frequencyHz",
				"consumptionW"
			],
			"properties": {
				"hasExternalPowerAdapter": {
					"type": ["boolean", "null"]
				},
				"outputVoltageV": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"outputCurrentA": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"outputPowerW": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"inputVoltageRangeV": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["minimum", "maximum"],
							"properties": {
								"minimum": {
									"type": "number",
									"minimum": 0
								},
								"maximum": {
									"type": "number",
									"minimum": 0
								}
							}
						}
					]
				},
				"frequencyHz": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"consumptionW": {
					"type": ["number", "null"],
					"minimum": 0
				}
			}
		},
		"batteryAndPower": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"hasBattery",
				"batteryCapacityMah",
				"batteryCapacityWhr",
				"runtimeHours",
				"charging",
				"powerSupply"
			],
			"properties": {
				"hasBattery": {
					"type": "boolean"
				},
				"batteryCapacityMah": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"batteryCapacityWhr": {
					"type": ["number", "null"],
					"minimum": 0
				},
				"runtimeHours": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/batteryRuntime"
					}
				},
				"charging": {
					"$ref": "#/$defs/charging"
				},
				"powerSupply": {
					"$ref": "#/$defs/powerSupply"
				}
			}
		},
		"wifi": {
			"type": "object",
			"additionalProperties": false,
			"required": ["standards"],
			"properties": {
				"standards": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"enum": [
							"Wi-Fi 4",
							"Wi-Fi 5",
							"Wi-Fi 6",
							"Wi-Fi 6E",
							"Wi-Fi 7",
							"Wi-Fi 8"
						]
					}
				},
				"chip": {
					"type": "string"
				},
				"MIMO": {
					"type": "string"
				},
				"simultaneousDualBand": {
					"type": ["boolean", "null"]
				}
			}
		},
		"bluetooth": {
			"type": "object",
			"additionalProperties": false,
			"required": ["version"],
			"properties": {
				"version": {
					"enum": [
						"Bluetooth 4.0",
						"Bluetooth 4.2",
						"Bluetooth 5.0",
						"Bluetooth 5.3",
						"Bluetooth 5.4",
						"Bluetooth 6.0"
					]
				}
			}
		},
		"cellular": {
			"type": "object",
			"additionalProperties": false,
			"required": ["technologies"],
			"properties": {
				"technologies": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"enum": ["LTE", "5G sub-6", "5G mmWave"]
					}
				},
				"bands": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"eSIMOnly": {
					"type": ["boolean", "null"]
				}
			}
		},
		"uwb": {
			"type": "object",
			"additionalProperties": false,
			"required": ["chip"],
			"properties": {
				"chip": {
					"type": "string"
				},
				"secondGeneration": {
					"type": ["boolean", "null"]
				}
			}
		},
		"thread": {
			"type": "object",
			"additionalProperties": false,
			"required": ["supported"],
			"properties": {
				"supported": {
					"type": "boolean"
				},
				"role": {
					"enum": ["endpoint", "border-router", "both", null]
				}
			}
		},
		"infrared": {
			"type": "object",
			"additionalProperties": false,
			"required": ["present", "purpose"],
			"properties": {
				"present": {
					"type": "boolean"
				},
				"purpose": {
					"type": ["string", "null"]
				}
			}
		},
		"nearFieldCommunication": {
			"type": "object",
